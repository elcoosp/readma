{
  "nodeModulesDir": "auto",
  "workspace": [
    "./packages/core",
    "./packages/cli",
    "./packages/pkg-json"
  ],
  "tasks": {
    "r": "deno run -A packages/cli/src/mod.ts gen",
    "r:w": "deno run -A --watch packages/cli/src/mod.ts gen",
    "gen:check": "deno run -A packages/cli/src/mod.ts gen --check --offline",
    "validate": "deno run -A packages/cli/src/mod.ts validate",
    "schema": "deno run -A packages/cli/src/mod.ts schema",
    "c": "git cliff -o CHANGELOG.md",
    "f": "deno fmt",
    "lint:ox": "oxlint --deny-warnings",
    "cov": "deno test -A --coverage=cov && deno coverage cov"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.3.1",
    "@mdx-js/mdx": "npm:@mdx-js/mdx@^3.1.1",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/fs": "jsr:@std/fs@1.0.24",
    "@std/jsonc": "jsr:@std/jsonc@1.0.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/toml": "jsr:@std/toml@1.0.11",
    "@wok/case": "jsr:@wok/case@^1.0.3",
    "react": "npm:react@^19.3.1",
    "react-dom": "npm:react-dom@^19.3.1",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "@david/dax": "jsr:@david/dax@^0.50.1"
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": false,
    "exclude": [
      "**/README.md",
      "**/CHANGELOG.md",
      "**/docs",
      ".vscode",
      "deno_cache",
      "packages/documentation",
      ".changeset",
      "cov"
    ]
  },
  "lint": {
    "exclude": [
      "**/docs",
      "deno_cache",
      "packages/documentation",
      "cov"
    ]
  }
}
